{
  "name": "screenpass",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "start:api": "tsx server/src/index.ts",
    "build": "tsc --noEmit && vite build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:setup-owner": "tsx prisma/setup-owner.ts",
    "db:start": "mysqld --no-defaults --datadir=\"$PWD/.local/dev-mysql\" --socket=\"$PWD/.local/mysql.sock\" --port=3307 --bind-address=127.0.0.1 --mysqlx=OFF --pid-file=\"$PWD/.local/mysql.pid\" --log-error=\"$PWD/.local/mysql.log\""
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "axios": "^1.13.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/leaflet": "^1.9.17",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^26.1.0",
    "prisma": "6.19.0",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
